# Copie este arquivo para ".env" e preencha com os seus valores:  cp .env.example .env

PORT=3000
NODE_ENV=production

# Banco MySQL na nuvem (Aiven) — painel: Overview > Connection information
DB_HOST=seu-servico.c.aivencloud.com
DB_PORT=00000
DB_USER=avnadmin
DB_PASSWORD=
DB_NAME=defaultdb
DB_SSL=true
# Baixe o certificado CA no painel Aiven e configure em produção:
DB_SSL_CA=certs/ca.pem

# Opcional: origens externas separadas por vírgula. Deixe vazio se o frontend
# for servido pela própria API (mesma origem).
CORS_ORIGINS=

# Gere um segredo longo e aleatório:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=8h

NODE_API_URL=http://localhost:3000
PYTHON_INTERNAL_KEY=
# Linux: python3. No Windows, configure PYTHON_BIN=python.
PYTHON_BIN=python3

IMPORTACAO_MAX_MB=20
IMPORTACAO_TIMEOUT_S=1800
IMPORTACAO_MAX_SIMULTANEAS=1
LOGIN_MAX_TENTATIVAS=10
LOGIN_JANELA_SEGUNDOS=900

