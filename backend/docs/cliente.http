# Requisições de teste da API (extensão REST Client do VS Code).
# Preencha @adminEmail/@adminSenha, rode o login do professor e cole o token em @token.
# Não grave token nem senha reais neste arquivo — ele é versionado no Git.

@baseURL = http://localhost:3000
@adminEmail = SEU_EMAIL_DE_COORDENADORA
@adminSenha = SUA_SENHA
@token = COLE_AQUI_O_TOKEN_RETORNADO_PELO_LOGIN_DO_PROFESSOR
GET {{baseURL}}/db
Content-Type: application/json

### ----------------- LOGIN PROFESSOR (público) -----------------
POST {{baseURL}}/professor/login
Content-Type: application/json

{
    "email": "{{adminEmail}}",
    "senha": "{{adminSenha}}"
}

### ----------------- LOGIN TURMA (público, usado pelo aluno) -----------------
POST {{baseURL}}/login/turma
Content-Type: application/json

{
    "turma": "informatica",
    "ano": 1,
    "codigoTurma": "123"
}

### ================= CRUD PROFESSORES (somente coordenadora) =================

### Criar professor
POST {{baseURL}}/professor
Content-Type: application/json
Authorization: Bearer {{token}}

{
    "nome": "lucas",
    "email": "lucas@example.com",
    "senha": "senha123",
    "admin": false
}

### Listar professores
GET {{baseURL}}/professor
Authorization: Bearer {{token}}

### Buscar professor por id
GET {{baseURL}}/professor/3
Authorization: Bearer {{token}}

### Atualizar professor
PUT {{baseURL}}/professor/3
Content-Type: application/json
Authorization: Bearer {{token}}

{
    "nome": "Admin"
}

### Excluir professor
DELETE {{baseURL}}/professor/4
Authorization: Bearer {{token}}

### ================= CRUD TURMAS (somente coordenadora) =================

### Criar turma
POST {{baseURL}}/turmas
Content-Type: application/json
Authorization: Bearer {{token}}

{
    "nome": "mecatronica",
    "ano": 3,
    "codigo": "397",
    "turno": "integral"
}

### Listar turmas
GET {{baseURL}}/turmas
Authorization: Bearer {{token}}

### Buscar turma por id
GET {{baseURL}}/turmas/2
Authorization: Bearer {{token}}

### Atualizar turma
PUT {{baseURL}}/turmas/1
Content-Type: application/json
Authorization: Bearer {{token}}

{
    "turno": "integral"
}

### Excluir turma
DELETE {{baseURL}}/turmas/2
Authorization: Bearer {{token}}
