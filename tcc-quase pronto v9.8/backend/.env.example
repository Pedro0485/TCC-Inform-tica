# Copie este arquivo para ".env" e preencha com os seus valores:  cp .env.example .env

PORT=3000

# Banco MySQL na nuvem (Aiven) — painel: Overview > Connection information
DB_HOST=seu-servico.c.aivencloud.com
DB_PORT=00000
DB_USER=avnadmin
DB_PASSWORD=
DB_NAME=defaultdb
DB_SSL=true
# DB_SSL_CA=certs/ca.pem

# Gere um segredo longo e aleatório:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=30d

NODE_API_URL=http://localhost:3000
PYTHON_INTERNAL_KEY=
PYTHON_BIN=python

IMPORTACAO_MAX_MB=20
IMPORTACAO_TIMEOUT_S=1800
IMPORTACAO_MAX_SIMULTANEAS=1

