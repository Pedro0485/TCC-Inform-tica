PORT=

DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=

JWT_SECRET=
JWT_EXPIRES_IN=

# URL onde o próprio Node está rodando — o script Python usa isso pra
# devolver os horários lidos do PDF via POST /turmas/horarios-lidos
NODE_API_URL=http://localhost:3000

# Chave compartilhada entre Node e Python só pra essa rota interna
# (gere qualquer string aleatória e use o mesmo valor nos dois lados)
PYTHON_INTERNAL_KEY=

# Executável do Python usado pelo Node (child_process) pra rodar read_pdf.py.
# No Windows costuma ser "python"; no Linux/Mac normalmente "python3".
PYTHON_BIN=python3